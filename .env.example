# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, confirmation links, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_JSON: Required for server-side Firestore subscriber storage & cron jobs.
# Paste the single-line JSON (or base64-encoded JSON) of a Firebase Admin SDK service account for project fit-gauge-19n9n.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Email Delivery (Resend Only)
# During testing without a custom domain, EMAIL_FROM defaults to "Campus Connect <onboarding@resend.dev>".
# Keep EMAIL_TEST_MODE="true" so emails only go to your verified Resend account email (EMAIL_TEST_RECIPIENT).
# Set EMAIL_TEST_MODE="false" only after adding a custom verified domain in EMAIL_FROM.
RESEND_API_KEY=""
EMAIL_TEST_MODE="true"
EMAIL_TEST_RECIPIENT="fredaesiofori905@gmail.com"
EMAIL_FROM="Campus Connect <onboarding@resend.dev>"
EMAIL_REPLY_TO=""

# ALERT_CRON_SECRET: Bearer secret used to authorize POST /api/alerts/cron/deadlines
ALERT_CRON_SECRET=""

# VITE_FIREBASE_VAPID_KEY: Optional Web Push certificate key pair for Firebase Cloud Messaging browser notifications.
# Leave blank in AI Studio Starter Tier; configure from Firebase Console -> Cloud Messaging -> Web Push certificates for deployment.
VITE_FIREBASE_VAPID_KEY=""
