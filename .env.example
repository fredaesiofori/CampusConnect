# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, confirmation links, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT_JSON: Required for server-side Firestore subscriber storage & cron jobs.
# Paste the single-line JSON (or base64-encoded JSON) of a Firebase Admin SDK service account for project fit-gauge-19n9n.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Email Delivery Provider (Configure Resend OR SendGrid + a verified sender address)
# For testing without a custom domain, leave EMAIL_FROM unset (defaults to "Campus Connect <onboarding@resend.dev>" in strict test-only mode).
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="Campus Connect <onboarding@resend.dev>"
EMAIL_TEST_RECIPIENT="fredaesiofori905@gmail.com"
EMAIL_TEST_MODE="true"
EMAIL_REPLY_TO=""

# ALERT_CRON_SECRET: Bearer secret used to authorize POST /api/alerts/cron/deadlines
ALERT_CRON_SECRET=""

